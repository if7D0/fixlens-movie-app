// FixLens Firestore rules (Phase 4). Deploy:
//   firebase deploy --only firestore:rules
// Notes:
// - google-services.json / firebase_options.dart are committed demo config
//   (no secrets); real protection lives HERE + SHA/package restrictions.
// - v1 limitation: review summary docs are written by clients inside the same
//   transaction as the review (no Cloud Functions). Any signed-in user can
//   write a summary doc; integrity relies on the app's transaction logic.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data: owner only.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /watchlist/{movieId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Public reviews: anyone reads, owners write their own doc.
    match /movie_reviews/{movieId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 10
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    // REQUIRED for collectionGroup('reviews') ("Ulasan saya"): nested
    // matches above do NOT cover group queries — Firestore mandates an
    // explicit /{path=**}/ rule (rules_version 2). Same validations.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == reviewId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null
        && request.auth.uid == reviewId;
    }
  }
}
